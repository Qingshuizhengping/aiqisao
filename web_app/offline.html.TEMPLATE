<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#f9fafb">
<title>薇之雨 · AI七嫂</title>
<style>
{{APP_STYLES}}
</style>
</head>
<body>
{{APP_BODY}}
<script>
/**
 * AI七嫂 - 薇之雨品牌智能问答系统（离线增强版）
 * 离线时显示完整主界面，API 请求失败时优雅降级
 */
(function() {
'use strict';

const chatContainer = document.getElementById('chatContainer');
const userInput = document.getElementById('userInput');
const sendBtn = document.getElementById('sendBtn');
const mainPanel = document.getElementById('mainPanel');
const welcomeTemplate = document.getElementById('welcomeTemplate');
const sidebarList = document.getElementById('sidebarList');
const sidebar = document.getElementById('sidebar');
const sidebarOverlay = document.getElementById('sidebarOverlay');
const menuBtn = document.getElementById('menuBtn');
const offlineBanner = document.getElementById('offlineBanner');
const drawerMedia = window.matchMedia('(max-width: 760px), (max-height: 500px) and (max-width: 1000px)');
const AVATAR_URI = 'AVATAR_DATA_URI';

let drawerReturnFocus = null;

let isProcessing = false;
let conversations = [];
let currentConvId = null;
let isOnline = true;

const STORAGE_KEY = 'qisao_conversations';
const API_BASE = 'https://web-production-b0601.up.railway.app';
const CONNECTIVITY_CHECK_INTERVAL = 15000; // 15秒检查一次

// ==================== 离线检测 ====================
function checkConnectivity() {
    // 尝试请求 API 根路径来判断是否在线
    fetch(API_BASE + '/', { method: 'HEAD', mode: 'no-cors', cache: 'no-cache' })
        .then(function() { setOnlineStatus(true); })
        .catch(function() { setOnlineStatus(false); });
}

function setOnlineStatus(online) {
    isOnline = online;
    offlineBanner.classList.toggle('show', !online);
    var statusText = document.querySelector('.status-text');
    var statusDot = document.querySelector('.status-dot');
    if (statusText) statusText.textContent = online ? '在线' : '离线';
    if (statusDot) statusDot.classList.toggle('is-offline', !online);
}

// 初始检查 + 定期检查
checkConnectivity();
setInterval(checkConnectivity, CONNECTIVITY_CHECK_INTERVAL);

// 也监听浏览器 online/offline 事件
window.addEventListener('online', function() { setOnlineStatus(true); });
window.addEventListener('offline', function() { setOnlineStatus(false); });

// ==================== 对话管理 ====================
function loadConversations() {
    try {
        var raw = localStorage.getItem(STORAGE_KEY);
        if (raw) conversations = JSON.parse(raw);
    } catch(e) {
        conversations = [];
    }
}

function saveConversations() {
    try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(conversations));
    } catch(e) {}
}

function genId() {
    return Date.now().toString(36) + Math.random().toString(36).substr(2, 6);
}

function formatDate(ts) {
    var d = new Date(ts);
    var now = new Date();
    var diff = now - d;
    if (diff < 60000) return '刚刚';
    if (diff < 3600000) return Math.floor(diff/60000) + '分钟前';
    if (diff < 86400000) return Math.floor(diff/3600000) + '小时前';
    if (diff < 172800000) return '昨天';
    return (d.getMonth()+1) + '/' + d.getDate();
}

function getConvTitle(conv) {
    if (conv.title) return conv.title;
    var first = null;
    if (conv.messages) {
        for (var i = 0; i < conv.messages.length; i++) {
            if (conv.messages[i].role === 'user') { first = conv.messages[i]; break; }
        }
    }
    if (first) {
        var t = first.text;
        return t.length > 16 ? t.substring(0, 16) + '…' : t;
    }
    return '新对话';
}

function renderSidebar() {
    sidebarList.innerHTML = '';
    var sorted = conversations.slice().sort(function(a,b) { return b.updatedAt - a.updatedAt; });
    if (!sorted.length) {
        sidebarList.innerHTML = '<div class="sidebar-empty"><span>还没有对话记录</span><p>每一次交流，都从这里开始</p></div>';
        return;
    }
    sorted.forEach(function(conv) {
        var item = document.createElement('div');
        item.className = 'chat-item' + (conv.id === currentConvId ? ' active' : '');
        var selectButton = document.createElement('button');
        selectButton.type = 'button';
        selectButton.className = 'chat-item-select';
        selectButton.disabled = isProcessing;
        if (conv.id === currentConvId) selectButton.setAttribute('aria-current', 'true');
        selectButton.innerHTML = '<span class="ui-icon icon-message" aria-hidden="true"></span>' +
            '<span class="chat-item-info"><span class="chat-item-title">' + escapeHtml(getConvTitle(conv)) +
            '</span><span class="chat-item-date">' + formatDate(conv.updatedAt) + '</span></span>';
        selectButton.addEventListener('click', function() { switchChat(conv.id); });
        var deleteButton = document.createElement('button');
        deleteButton.type = 'button';
        deleteButton.className = 'chat-item-delete';
        deleteButton.disabled = isProcessing;
        deleteButton.setAttribute('aria-label', '删除对话：' + getConvTitle(conv));
        deleteButton.innerHTML = '<span class="ui-icon icon-trash" aria-hidden="true"></span>';
        deleteButton.addEventListener('click', function() { deleteChat(conv.id); });
        item.append(selectButton, deleteButton);
        sidebarList.appendChild(item);
    });
}

function newChat() {
    if (isProcessing) return;
    currentConvId = null;
    chatContainer.replaceChildren(welcomeTemplate.content.cloneNode(true));
    mainPanel.classList.add('is-welcome');
    renderSidebar();
    closeSidebar();
}

function switchChat(convId) {
    if (isProcessing) return;
    var conv = null;
    for (var i = 0; i < conversations.length; i++) {
        if (conversations[i].id === convId) { conv = conversations[i]; break; }
    }
    if (!conv) return;
    currentConvId = convId;
    chatContainer.innerHTML = '';
    mainPanel.classList.remove('is-welcome');
    conv.messages.forEach(function(msg) {
        if (msg.role === 'user') {
            var div = document.createElement('div');
            div.className = 'message message-user';
            div.innerHTML = '<div class="bubble">' + escapeHtml(msg.text) + '</div>';
            chatContainer.appendChild(div);
        } else if (msg.role === 'qisao') {
            var div = document.createElement('div');
            div.className = 'message message-qisao';
            div.innerHTML = '<div class="qisao-avatar"><img src="' + AVATAR_URI + '" class="avatar-img" alt="AI七嫂"></div><div class="qisao-bubble">' + (msg.html || '') + '</div>';
            chatContainer.appendChild(div);
        }
    });
    scrollToBottom();
    renderSidebar();
    closeSidebar();
}

function deleteChat(convId) {
    if (isProcessing) return;
    conversations = conversations.filter(function(c) { return c.id !== convId; });
    saveConversations();
    if (currentConvId === convId) {
        newChat();
    }
    renderSidebar();
}

function getCurrentConv() {
    if (!currentConvId) return null;
    for (var i = 0; i < conversations.length; i++) {
        if (conversations[i].id === currentConvId) return conversations[i];
    }
    return null;
}

function ensureConv() {
    if (!currentConvId) {
        var conv = {
            id: genId(),
            title: '',
            messages: [],
            createdAt: Date.now(),
            updatedAt: Date.now()
        };
        conversations.push(conv);
        currentConvId = conv.id;
        saveConversations();
        renderSidebar();
    }
    return getCurrentConv();
}

function toggleSidebar() {
    if (!drawerMedia.matches) return;
    if (sidebar.classList.contains('open')) {
        closeSidebar();
        return;
    }
    drawerReturnFocus = document.activeElement;
    sidebar.classList.add('open');
    syncDrawerState();
    var firstButton = sidebar.querySelector('button:not(:disabled)');
    if (firstButton) firstButton.focus();
}

function syncDrawerState() {
    var isOpen = drawerMedia.matches && sidebar.classList.contains('open');
    sidebar.inert = drawerMedia.matches && !isOpen;
    mainPanel.inert = isOpen;
    sidebarOverlay.classList.toggle('show', isOpen);
    menuBtn.setAttribute('aria-expanded', String(isOpen));
    updateAppHeight();
}

function updateAppHeight() {
    var viewport = window.visualViewport;
    if (drawerMedia.matches && viewport && Math.abs(viewport.scale - 1) < 0.05) {
        document.documentElement.style.setProperty('--app-height', viewport.height + 'px');
    } else {
        document.documentElement.style.removeProperty('--app-height');
    }
}

function closeSidebar(restoreFocus) {
    var wasOpen = sidebar.classList.contains('open');
    sidebar.classList.remove('open');
    syncDrawerState();
    if (wasOpen && restoreFocus !== false) {
        var target = drawerReturnFocus && drawerReturnFocus.isConnected ? drawerReturnFocus : menuBtn;
        target.focus();
    }
}

drawerMedia.addEventListener('change', function() { closeSidebar(false); });
window.addEventListener('resize', updateAppHeight);
if (window.visualViewport) window.visualViewport.addEventListener('resize', updateAppHeight);
document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
        closeSidebar();
        return;
    }
    if (event.key !== 'Tab' || !drawerMedia.matches || !sidebar.classList.contains('open')) return;
    var focusable = sidebar.querySelectorAll('button:not(:disabled), a[href], [tabindex]:not([tabindex="-1"])');
    if (!focusable.length) return;
    var firstElement = focusable[0];
    var lastElement = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === firstElement) {
        event.preventDefault();
        lastElement.focus();
    } else if (!event.shiftKey && document.activeElement === lastElement) {
        event.preventDefault();
        firstElement.focus();
    }
});

// ==================== 消息 UI ====================
function autoResize(el) {
    el.style.height = 'auto';
    el.style.height = Math.min(el.scrollHeight, 100) + 'px';
}

userInput.addEventListener('input', function() { autoResize(this); });

function handleKeyDown(e) {
    if (e.key === 'Enter' && !e.shiftKey && !e.isComposing && e.keyCode !== 229) {
        e.preventDefault();
        sendMessage();
    }
}

function quickAsk(question) {
    if (isProcessing) return;
    userInput.value = question;
    sendMessage();
}

function hideWelcome() {
    var ws = document.getElementById('welcomeSection');
    if (ws) ws.remove();
    mainPanel.classList.remove('is-welcome');
}

function addUserMessage(text) {
    hideWelcome();
    var div = document.createElement('div');
    div.className = 'message message-user';
    div.innerHTML = '<div class="bubble">' + escapeHtml(text) + '</div>';
    chatContainer.appendChild(div);
    scrollToBottom();
}

function addQisaoMessage(html) {
    var div = document.createElement('div');
    div.className = 'message message-qisao';
    div.innerHTML =
        '<div class="qisao-avatar"><img src="' + AVATAR_URI + '" class="avatar-img" alt="AI七嫂"></div>' +
        '<div class="qisao-bubble">' + html + '</div>';
    chatContainer.appendChild(div);
    scrollToBottom();
}

function createStreamingQisaoMessage() {
    var div = document.createElement('div');
    div.className = 'message message-qisao';
    div.innerHTML =
        '<div class="qisao-avatar"><img src="' + AVATAR_URI + '" class="avatar-img" alt="AI七嫂"></div>' +
        '<div class="qisao-bubble">' +
            '<div class="stream-loading" id="streamLoading">' +
                '<span class="loading-dot"></span>' +
                '<span class="loading-dot"></span>' +
                '<span class="loading-dot"></span>' +
            '</div>' +
        '</div>';
    chatContainer.appendChild(div);
    scrollToBottom();
    return div.querySelector('.qisao-bubble');
}

function removeStreamLoading() {
    var loading = document.getElementById('streamLoading');
    if (loading) loading.remove();
}

function renderStreamingText(text) {
    return escapeHtml(text).replace(/\n/g, '<br>');
}

function addSystemMessage(text) {
    var div = document.createElement('div');
    div.className = 'message message-system';
    div.innerHTML = '<div class="bubble">' + escapeHtml(text) + '</div>';
    chatContainer.appendChild(div);
    scrollToBottom();
}

function showTyping() {
    var div = document.createElement('div');
    div.className = 'typing-indicator';
    div.id = 'typingIndicator';
    div.innerHTML =
        '<div class="qisao-avatar" style="width:32px;height:32px;flex-shrink:0;"><img src="' + AVATAR_URI + '" class="avatar-img" alt="AI七嫂"></div>' +
        '<div class="typing-bubble"><span class="typing-label">Thinking</span><div class="typing-dots"><span></span><span></span><span></span></div></div>';
    chatContainer.appendChild(div);
    scrollToBottom();
}

function hideTyping() {
    var el = document.getElementById('typingIndicator');
    if (el) el.remove();
}

function scrollToBottom() {
    chatContainer.scrollTop = chatContainer.scrollHeight;
}

function escapeHtml(text) {
    var div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

function htmlToPlainText(html) {
    var div = document.createElement('div');
    div.innerHTML = html || '';
    return div.textContent || div.innerText || '';
}

function buildConversationContext(conv) {
    if (!conv || !Array.isArray(conv.messages)) return [];
    return conv.messages.slice(-8).map(function(msg) {
        if (msg.role === 'user') {
            return { role: 'user', content: msg.text || '' };
        }
        return { role: 'assistant', content: htmlToPlainText(msg.html || msg.text || '') };
    }).filter(function(msg) { return msg.content && msg.content.trim(); });
}

// ==================== API 通信 ====================
function showOfflineFallback() {
    hideTyping();
    addQisaoMessage(
        '<p>📡 <strong>当前处于离线状态</strong></p>' +
        '<p>AI七嫂需要联网才能回答您的问题。请检查网络连接后重试。</p>' +
        '<p style="color:#8E8E93;font-size:14px;">离线时您可以查看历史对话记录，所有数据已安全保存在本地。</p>'
    );
    setOnlineStatus(false);
}

function showNetworkError() {
    hideTyping();
    addQisaoMessage(
        '<p>⚠️ <strong>网络连接失败</strong></p>' +
        '<p>无法连接到AI七嫂服务器，请稍后重试。您可以：</p>' +
        '<ul>' +
            '<li>检查手机网络设置</li>' +
            '<li>确认服务器状态</li>' +
            '<li>稍后再试</li>' +
        '</ul>'
    );
}

function fetchNormalAnswer(text, conv, history) {
    var controller = new AbortController();
    var timeoutId = setTimeout(function() { controller.abort(); }, 30000);

    return fetch(API_BASE + '/api/query', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question: text, history: history || [] }),
        signal: controller.signal
    }).then(function(resp) {
        clearTimeout(timeoutId);
        if (!resp.ok) throw new Error('Server error: ' + resp.status);
        return resp.json();
    }).then(function(data) {
        hideTyping();
        if (data.status === 'ok') {
            addQisaoMessage(data.html);
            conv.messages.push({ role: 'qisao', html: data.html });
            conv.updatedAt = Date.now();
            saveConversations();
            setOnlineStatus(true);
            return true;
        }
        addSystemMessage('查询出错: ' + (data.error || '未知错误'));
        return false;
    }).catch(function(err) {
        clearTimeout(timeoutId);
        hideTyping();
        if (err && err.name === 'AbortError') {
            addQisaoMessage('<p>⏱️ <strong>请求超时</strong></p><p>服务器响应时间过长，请稍后重试。</p>');
        } else if (!navigator.onLine) {
            showOfflineFallback();
        } else {
            showNetworkError();
        }
        return false;
    });
}

function sendMessage() {
    var text = userInput.value.trim();
    if (!text || isProcessing) return;

    setProcessing(true);
    userInput.value = '';
    userInput.style.height = 'auto';

    var conv = ensureConv();
    addUserMessage(text);
    conv.messages.push({ role: 'user', text: text });
    if (!conv.title) conv.title = text.length > 16 ? text.substring(0, 16) + '…' : text;
    conv.updatedAt = Date.now();
    saveConversations();
    renderSidebar();

    var history = buildConversationContext(conv);

    // 先检查在线状态
    if (!navigator.onLine) {
        showOfflineFallback();
        setProcessing(false);
        userInput.focus();
        return;
    }

    showTyping();

    // 安全超时：60秒后强制重置状态
    var safetyTimeout = setTimeout(function() {
        if (isProcessing) {
            hideTyping();
            removeStreamLoading();
            addQisaoMessage('<p>⏱️ <strong>请求超时</strong></p><p>服务器响应时间过长，请稍后重试。</p>');
            setProcessing(false);
            userInput.focus();
        }
    }, 60000);

    // 尝试流式请求（带超时）
    var streamController = new AbortController();
    var streamTimeoutId = setTimeout(function() { streamController.abort(); }, 15000);

    fetch(API_BASE + '/api/query_stream', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question: text, history: history }),
        signal: streamController.signal
    }).then(function(resp) {
        clearTimeout(streamTimeoutId);
        if (!resp.ok || !resp.body || !window.ReadableStream) {
            // 降级到普通请求
            return fetchNormalAnswer(text, conv, history);
        }

        var reader = resp.body.getReader();
        var decoder = new TextDecoder('utf-8');
        var buffer = '';
        var markdownText = '';
        var finalHtml = '';
        var bubble = null;
        var hasStarted = false;

        function processStream() {
            return reader.read().then(function(result) {
                if (result.done) {
                    if (!hasStarted) {
                        return fetchNormalAnswer(text, conv, history);
                    }
                    // 流结束但没收到 done 事件，用已收集的文本作为最终结果
                    if (!finalHtml && markdownText) {
                        finalHtml = renderStreamingText(markdownText);
                        if (bubble) bubble.innerHTML = finalHtml;
                        conv.messages.push({ role: 'qisao', html: finalHtml });
                        conv.updatedAt = Date.now();
                        saveConversations();
                        setOnlineStatus(true);
                    }
                    hideTyping();
                    removeStreamLoading();
                    return;
                }

                buffer += decoder.decode(result.value, { stream: true });
                var lines = buffer.split(/\r?\n/);
                buffer = lines.pop() || '';

                for (var i = 0; i < lines.length; i++) {
                    var line = lines[i];
                    if (line.indexOf('data: ') !== 0) continue;
                    var payload = line.slice(6).trim();
                    if (!payload) continue;

                    var data;
                    try {
                        data = JSON.parse(payload);
                    } catch (e) {
                        continue;
                    }

                    if (data.type === 'start') {
                        hasStarted = true;
                        hideTyping();
                        if (!bubble) bubble = createStreamingQisaoMessage();
                    } else if (data.type === 'token') {
                        hasStarted = true;
                        if (!bubble) {
                            hideTyping();
                            bubble = createStreamingQisaoMessage();
                        }
                        removeStreamLoading();
                        markdownText += data.content || '';
                        bubble.innerHTML = renderStreamingText(markdownText);
                        scrollToBottom();
                    } else if (data.type === 'done') {
                        hasStarted = true;
                        removeStreamLoading();
                        finalHtml = data.html || renderStreamingText(markdownText);
                        if (!bubble) {
                            hideTyping();
                            bubble = createStreamingQisaoMessage();
                        }
                        bubble.innerHTML = finalHtml;
                        conv.messages.push({ role: 'qisao', html: finalHtml });
                        conv.updatedAt = Date.now();
                        saveConversations();
                        setOnlineStatus(true);
                        scrollToBottom();
                    } else if (data.type === 'error') {
                        hideTyping();
                        removeStreamLoading();
                        addSystemMessage('查询出错: ' + (data.error || '未知错误'));
                    }
                }
                return processStream();
            });
        }

        return processStream();
    }).catch(function(err) {
        clearTimeout(streamTimeoutId);
        // 流式失败，尝试普通请求
        return fetchNormalAnswer(text, conv, history).catch(function() {
            hideTyping();
            if (!navigator.onLine) {
                showOfflineFallback();
            } else {
                showNetworkError();
            }
        });
    }).then(function() {
        clearTimeout(safetyTimeout);
        setProcessing(false);
        userInput.focus();
    });
}

function setProcessing(processing) {
    isProcessing = processing;
    mainPanel.setAttribute('aria-busy', String(processing));
    sendBtn.disabled = processing;
    sendBtn.setAttribute('aria-label', processing ? '正在等待回答' : '发送消息');
    document.querySelectorAll('.quick-btn, .new-chat-btn, .chat-item-select, .chat-item-delete').forEach(function(button) {
        button.disabled = processing;
    });
}

// ==================== 初始化 ====================
function initApp() {
    loadConversations();
    renderSidebar();

    if (conversations.length > 0) {
        var sorted = conversations.slice().sort(function(a,b) { return b.updatedAt - a.updatedAt; });
        switchChat(sorted[0].id);
    } else {
        newChat();
    }
    syncDrawerState();
}

initApp();

// 暴露函数到全局，供 HTML onclick 调用
window.sendMessage = sendMessage;
window.handleKeyDown = handleKeyDown;
window.quickAsk = quickAsk;
window.toggleSidebar = toggleSidebar;
window.closeSidebar = closeSidebar;
window.newChat = newChat;
})();
</script>
</body>
</html>
