# 服务器运行时变量模板
# 复制为 .env 后填值：cp .env.example .env
# .env 已被 .gitignore 排除，不会入库

# ---- 必填：对话模型（硅基流动）----
SILICONFLOW_API_KEY=

# ---- 必填：混元生图（腾讯 tokenhub）----
HUNYUAN_API_KEY=

# ---- 选填：覆盖模型与上游地址（默认值见下）----
# HUNYUAN_IMAGE_MODEL=hy-image-v3.5-preview
# HUNYUAN_IMAGE_API_URL=https://tokenhub.tencentmaas.com/v1/wand/hunyuan-image/v35-generation

# ---- 选填：文字提示词优化（默认关闭；不额外上传参考图）----
# PROMPT_OPTIMIZER_ENABLED=true
# 不填写时复用当前聊天服务的地址、模型和密钥，但使用独立的优化指令
# PROMPT_OPTIMIZER_API_BASE=https://api.siliconflow.cn/v1
# PROMPT_OPTIMIZER_MODEL=zai-org/GLM-5.3-Flash
# PROMPT_OPTIMIZER_API_KEY=
# PROMPT_OPTIMIZER_TIMEOUT_MS=20000
# 签名密钥仅放服务端；不填则进程启动时随机生成，重启后旧票据失效
# PROMPT_OPTIMIZER_SIGNING_KEY=

# ---- 选填：服务端口（默认 3000，nginx 反代到此端口）----
# PORT=3000
