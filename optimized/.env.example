# 服务器运行时变量模板
# 复制为 .env 后填值：cp .env.example .env
# .env 已被 .gitignore 排除，不会入库

# ---- 必填：对话模型（硅基流动）----
SILICONFLOW_API_KEY=

# ---- 必填：混元生图（腾讯 tokenhub）----
HUNYUAN_API_KEY=

# ---- 选填：覆盖模型与上游地址（默认值见下）----
# HUNYUAN_IMAGE_MODEL=hy-image-v3.5-preview
# HUNYUAN_IMAGE_API_URL=https://tokenhub.tencentmaas.com/v1/wand/hunyuan-image/v35-generation

# ---- 选填：服务端口（默认 3000，nginx 反代到此端口）----
# PORT=3000
