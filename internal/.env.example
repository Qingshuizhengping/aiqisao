NODE_ENV=production
INTERNAL_ORIGIN=https://8.134.141.217:6069
INTERNAL_HOST=127.0.0.1
INTERNAL_PORT=3001
INTERNAL_DATA_DIRECTORY=./var
INTERNAL_ENCRYPTION_KEY=
INTERNAL_BOOTSTRAP_USERNAME=admin
INTERNAL_BOOTSTRAP_PASSWORD=
INTERNAL_API_BASE=https://api.siliconflow.cn/v1
INTERNAL_API_KEY=
INTERNAL_CHAT_MODEL=zai-org/GLM-5.3-Flash
INTERNAL_MEMORY_MODEL=zai-org/GLM-5.3-Flash
INTERNAL_EMBEDDING_MODEL=BAAI/bge-m3
BACKUP_ENCRYPTION_KEY=
BACKUP_EXPORT_DIRECTORY=
INTERNAL_BACKUP_DIRECTORY=/opt/ai-qisao-internal/backups

# 回答模式：free = 默认开放回答（流式，检索为空也照常回答）；strict = 回滚到四阶段依据核验。
INTERNAL_GROUNDING_MODE=free
# 存储失败熔断冷却（毫秒，50-600000）。测试会把值压到 80ms，生产保持 3000。
INTERNAL_CHAT_BREAKER_COOLDOWN_MS=3000

# 联网搜索（R1-05）。留空则功能不可用：静默降级为无搜索（不发任何外部请求、前端不显示搜索开关）。
# stub 仅供自动化测试；tavily 本轮为骨架，配置后只会降级、不会外发。
INTERNAL_SEARCH_PROVIDER=
INTERNAL_SEARCH_API_KEY=
INTERNAL_SEARCH_BASE_URL=
INTERNAL_SEARCH_TIMEOUT_MS=8000
INTERNAL_SEARCH_MAX_RESULTS=5

# 素材生成（R2，腾讯 TokenHub 混元生图）。API_KEY 留空 = 功能不可用：
# /api/images/options 回 enabled:false、提交任务返回 503 IMAGE_NOT_CONFIGURED，前端入口保留但置灰。
INTERNAL_IMAGE_API_KEY=
INTERNAL_IMAGE_MODEL=hy-image-v3.5-preview
INTERNAL_IMAGE_API_BASE=https://tokenhub.tencentmaas.com/v1/wand/hunyuan-image/v35-generation
# 上游同步返回，前端 2s 轮询；超时上限 180000（默认 150 秒，与上游契约一致）。
INTERNAL_IMAGE_TIMEOUT_MS=150000
# 全局并发与排队上限（排队满返回 503 IMAGE_QUEUE_FULL）。
INTERNAL_IMAGE_CONCURRENCY=2
INTERNAL_IMAGE_QUEUE_CAPACITY=8
# 每账号限流（超出返回 429 IMAGE_RATE_LIMITED + Retry-After）。
INTERNAL_IMAGE_MINUTE_LIMIT=5
INTERNAL_IMAGE_HOUR_LIMIT=30
# 图片落盘目录，默认 <INTERNAL_DATA_DIRECTORY>/images；必须位于数据目录之下，启动即校验。
INTERNAL_IMAGE_DIRECTORY=
